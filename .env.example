# Vaiśravaṇa Alpha configuration.
# Copy to .env and fill in. Never commit the filled copy.
#
# Both ALPHA_ and the legacy VAISRAVANA_ prefixes are read; ALPHA_ wins.

# ── mode ──────────────────────────────────────────────────────────────
# paper: simulated fills, no venue can be reached.
# live:  refuses to start unless an adapter is wired (it is not, by design).
ALPHA_MODE=paper
ALPHA_DATA=/data
ALPHA_LOG_LEVEL=INFO

# ── universe ──────────────────────────────────────────────────────────
ALPHA_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,1000PEPEUSDT,1000BONKUSDT,ENAUSDT,WLDUSDT,PENGUUSDT,AAVEUSDT,TAOUSDT,INJUSDT,APEUSDT,PUMPUSDT,WIFUSDT,CRVUSDT
ALPHA_DECISION_TF=1m
ALPHA_CONTEXT_TFS=1m,5m,15m

# ── market data ───────────────────────────────────────────────────────
# The futures STREAM host. fapi.binance.com is REST only and returns 403
# to a websocket handshake, which looks exactly like an IP ban.
ALPHA_BINANCE_WS_URL=wss://fstream.binance.com/ws
ALPHA_BINANCE_REST_BASE=https://fapi.binance.com
ALPHA_REST_POLL_S=5.0

# ── paper account ─────────────────────────────────────────────────────
# Starts at $10 and is allowed to reach zero. That is the experiment.
ALPHA_PAPER_BALANCE=10.0
ALPHA_PAPER_STOP=0.0
ALPHA_PAPER_FEE_OPEN=0.0002
ALPHA_PAPER_FEE_CLOSE=0.0004
ALPHA_PAPER_RISK_PCT=0.20

# ── pacing ────────────────────────────────────────────────────────────
ALPHA_WARMUP_S=90
ALPHA_MAX_OPEN_WAVES=8
ALPHA_MAX_WAVE_AGE_S=900

# ── telegram ──────────────────────────────────────────────────────────
# Leave the token empty to run headless; cards then go to the log.
TELEGRAM_BOT_TOKEN=
NOTIFY_CHAT_ID=
# Set when several bots share one chat, so /stop cannot hit the wrong bot.
ALPHA_BOT_USERNAME=
ALPHA_CMD_LISTEN=true
